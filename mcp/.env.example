# NitroStack Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal

# Patch Made In Heaven — Search & Embeddings
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
# Request timeout for Elasticsearch calls, in milliseconds.
ELASTICSEARCH_REQUEST_TIMEOUT_MS=30000

# Patch Made In Heaven — Embeddings & Fast LLM Reasoning (OpenRouter / Groq)
OPENROUTER_API_KEY=
# Optional fallback, tried once if the primary key is exhausted (out of credits,
# rate limited, etc.) after its own retries. Never required. (Phase 7)
OPENROUTER_API_KEY_2=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
# Must match the real output dimension of OPENROUTER_EMBEDDING_MODEL — required
# once OPENROUTER_API_KEY is set. Never hardcode this; the Elasticsearch
# dense_vector mapping is built from this value.
EMBEDDING_VECTOR_DIMENSIONS=
EMBEDDING_REQUEST_TIMEOUT_MS=15000

GROQ_API_KEY=
GROQ_REASONING_MODEL=qwen/qwen3.6-27b

# Patch Made In Heaven — Search Result Limits
SEARCH_RESULT_LIMIT_DEFAULT=5
SEARCH_RESULT_LIMIT_MAX=25

# Patch Made In Heaven — Sandbox Verification (Decision 005: Docker, not Modal)
# Container binary name/path. Override to "podman" on a machine without a
# `docker` CLI installed (podman is CLI-compatible for the flags we use).
SANDBOX_CONTAINER_RUNTIME=docker
SANDBOX_TIMEOUT_MS=10000
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_CPU_LIMIT=1
SANDBOX_PIDS_LIMIT=128
SANDBOX_MAX_OUTPUT_BYTES=65536

# Production Sandbox Provider (Decision 010, Phase 6). Explicit opt-in only —
# always defaults to "local" (Docker/podman). Set to "e2b" only on the actual
# NitroCloud deployment, where no container engine exists at all. Never set
# this to "e2b" on a local dev machine or in CI.
SANDBOX_PROVIDER=local
E2B_API_KEY=

# Server Transport Configuration (Optional)
# =============================================================================
# MCP_TRANSPORT_TYPE: Toggles transport mode. Values: stdio | http | dual.
# Defaults to 'stdio' in development and 'dual' in production/NODE_ENV=production.
# =============================================================================
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost
# ENABLE_CORS=true
